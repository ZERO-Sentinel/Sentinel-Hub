end

local function enableInfJump()
    if InfJump then return end
    local connections = {}
    local jumpHeld = false
    local function doJump()
        if jumpHeld then
            return
        end
        jumpHeld = true
        local character = player.Character
        if not character then
            jumpHeld = false
            return
        end
        local humanoid = character:FindFirstChildOfClass("Humanoid")
        if not humanoid or humanoid.Health <= 0 then
            jumpHeld = false
            return
        end
        if humanoid:GetState() == Enum.HumanoidStateType.Dead then
            jumpHeld = false
            return
        end
        humanoid.Jump = false
        humanoid.Jump = true
        humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
        task.delay(0.05, function()
            if character
                and character.Parent
                and humanoid.Parent == character
                and humanoid.Health > 0 then

                humanoid.Jump = false
            end
        end)
    end
    -- Computah
    connections[#connections + 1] = UserInputService.InputBegan:Connect(function(input, gameProcessed)
        if gameProcessed then
            return
        end
        if input.KeyCode == Enum.KeyCode.Space then
            doJump()
        end
    end)
    connections[#connections + 1] = UserInputService.InputEnded:Connect(function(input)
        if input.KeyCode == Enum.KeyCode.Space then
            jumpHeld = false
        end
    end)
    -- Mobile
    task.spawn(function()
        local touchGui = player.PlayerGui:WaitForChild("TouchGui", 10)
        if not touchGui then return end
        local touchControlFrame = touchGui:WaitForChild("TouchControlFrame", 10)
        if not touchControlFrame then return end
        local jumpButton = touchControlFrame:WaitForChild("JumpButton", 10)
        if not jumpButton then return end
        connections[#connections + 1] = jumpButton.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.Touch then
                doJump()
            end
        end)
        connections[#connections + 1] = jumpButton.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.Touch then
                jumpHeld = false
            end
        end)
    end)
    InfJump = connections
end

local function disableInfJump()
    if not InfJump then
        return
    end
    for _, connection in ipairs(InfJump) do
        if connection then
            connection:Disconnect()
        end
    end
    InfJump = nil
end

