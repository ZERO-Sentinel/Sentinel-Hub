local function playLedgeAnimation()
    local character = getCharacter()
    if not character then
        return nil
    end
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if not humanoid then
        return nil
    end
    local animator = humanoid:FindFirstChildOfClass("Animator")
    if not animator then
        animator = Instance.new("Animator")
        animator.Parent = humanoid
    end
    local animation = Instance.new("Animation")
    animation.AnimationId = "rbxassetid://180436334"
    local track = animator:LoadAnimation(animation)
    track.Priority = Enum.AnimationPriority.Action
    track.Looped = false
    track:Play()
    return track
end

local function getRaycastParams()
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    local excluded = {}
    local character = getCharacter()
    if character then
        table.insert(excluded, character)
    end
    for _, otherPlayer in ipairs(Players:GetPlayers()) do
        if otherPlayer.Character then
            table.insert(excluded, otherPlayer.Character)
        end
    end
    params.FilterDescendantsInstances = excluded
    return params
end

local function findLedge()
    local root = getRoot()
    if not root then
        return nil
    end
    local origin = root.Position
    local wallParams = getRaycastParams()
    local wallResult = workspace:Raycast(origin, root.CFrame.LookVector * WALL_DISTANCE, wallParams)
    if not wallResult then
        return nil
    end
    local topOrigin = wallResult.Position + Vector3.new(0, MAX_LEDGE_HEIGHT, 0)
    local topResult = workspace:Raycast(topOrigin, Vector3.new(0, -MAX_LEDGE_HEIGHT - 1, 0), wallParams)
    if not topResult then
        return nil
    end
    local height = topResult.Position.Y - root.Position.Y
    if height < MIN_LEDGE_HEIGHT or height > MAX_LEDGE_HEIGHT then
        return nil
    end
    return {
        wall = wallResult,
        top = topResult,
        height = height
    }
end

local grabbing = false

local function grabLedge(ledge)
    if grabbing then
        return
    end
    local root = getRoot()
    local character = getCharacter()
    if not root or not character then
        return
    end
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if not humanoid then
        return
    end
    grabbing = true
    local topPosition = ledge.top.Position
    local wallNormal = ledge.wall.Normal
    local targetPosition = topPosition + Vector3.new(0, 3, 0) - wallNormal * 0.8
    local targetCFrame = CFrame.lookAt(targetPosition, targetPosition - wallNormal)
    local oldAutoRotate = humanoid.AutoRotate
    humanoid.AutoRotate = false
    local track = playLedgeAnimation()
    local startCFrame = root.CFrame
    local duration = 0.35
    local startTime = tick()
    while tick() - startTime < duration do
        local alpha = (tick() - startTime) / duration
        alpha = alpha * alpha * (3 - 2 * alpha)
        root.CFrame = startCFrame:Lerp(targetCFrame, alpha)
        RunService.RenderStepped:Wait()
    end
    root.CFrame = targetCFrame
    if track then
        track:Stop(0.1)
        track:Destroy()
    end
    local shiftLockEnabled = false
    pcall(function()
        shiftLockEnabled = player.DevEnableMouseLock
            and UserInputService.MouseBehavior == Enum.MouseBehavior.LockCenter
    end)
    if shiftLockEnabled then
        local cameraLook = camera.CFrame.LookVector
        local flatLook = Vector3.new(cameraLook.X, 0, cameraLook.Z)
        if flatLook.Magnitude > 0.001 then
            flatLook = flatLook.Unit
            local finalCFrame = CFrame.lookAt(root.Position, root.Position + flatLook)
            local smoothDuration = 0.12
            local smoothStart = tick()
            local startRotation = root.CFrame.Rotation
            while tick() - smoothStart < smoothDuration do
                local alpha = (tick() - smoothStart) / smoothDuration
                alpha = alpha * alpha * (3 - 2 * alpha)
                local rotation = startRotation:Lerp( finalCFrame.Rotation, alpha)
                root.CFrame = CFrame.new(root.Position) * rotation
                RunService.RenderStepped:Wait()
            end
            root.CFrame = finalCFrame
        end
    end
    humanoid.AutoRotate = oldAutoRotate
    grabbing = false
end

local function saveOriginalLighting()
	if not originalLighting then
		originalLighting = {
			Brightness = Lighting.Brightness,
			ClockTime = Lighting.ClockTime,
			FogEnd = Lighting.FogEnd,
			GlobalShadows = Lighting.GlobalShadows,
			OutdoorAmbient = Lighting.OutdoorAmbient
		}
	end
end

local function applyFullbright()
	Lighting.Brightness = 2
	Lighting.ClockTime = 14
	Lighting.FogEnd = 100000
	Lighting.GlobalShadows = false
	Lighting.OutdoorAmbient = Color3.fromRGB(128, 128, 128)
end

local function restoreLighting()
	if originalLighting then
		Lighting.Brightness = originalLighting.Brightness
		Lighting.ClockTime = originalLighting.ClockTime
		Lighting.FogEnd = originalLighting.FogEnd
		Lighting.GlobalShadows = originalLighting.GlobalShadows
		Lighting.OutdoorAmbient = originalLighting.OutdoorAmbient

		originalLighting = nil
	end
end

