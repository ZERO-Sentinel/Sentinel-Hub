-- LOOPED FUNCTIONS
-- ============================================

RunService.RenderStepped:Connect(function()
    if isNoSlowEnabled then
        EnableNoSlow()
    end
    if thirdPersonState == 2 then
        local character = player.Character
        local root = character and character:FindFirstChild("HumanoidRootPart")
        if root then
            local direction = camera.CFrame.LookVector
            local cameraHeight = 2
            camera.CFrame = CFrame.lookAt(
                root.Position - direction * thirdPersonDistance + Vector3.new(0, cameraHeight, 0),
                root.Position + Vector3.new(0, cameraHeight, 0)
            )
        end
    end
    if firstPersonState == 2 then
        local character = player.Character
        local root = character and character:FindFirstChild("HumanoidRootPart")
        if root then
            local direction = camera.CFrame.LookVector
            camera.CFrame = CFrame.lookAt(
                root.Position,
                root.Position
            )
        end
    end
    if isBoxESP or isSkeletonESP or isChamsESP then
        for _, ESPTarget in ipairs(Players:GetPlayers()) do
            DrawESP(ESPTarget)
        end
    else
        for _, drawing in pairs(Drawings) do
            drawing.Visible = false
        end
        for _, ESPTarget in ipairs(Players:GetPlayers()) do
            local chams = CoreGui:FindFirstChild(ESPTarget.Name .. "Chams")
            if chams then
                chams:Destroy()
            end
        end
    end
    if isFullBrightEnabled then
	    if Lighting.Brightness ~= FullBright.Brightness
	    	or Lighting.ClockTime ~= FullBright.ClockTime
	    	or Lighting.FogEnd ~= FullBright.FogEnd
	    	or Lighting.GlobalShadows ~= FullBright.GlobalShadows
	    	or Lighting.OutdoorAmbient ~= FullBright.OutdoorAmbient then
	    	applyFullbright()
	    end
    end
    if not isLedgeClimberEnabled then
        return
    end
    if grabbing then
        return
    end
    local ledge = findLedge()
    if not ledge then
        return
    end
    if ledge.height >= MIN_LEDGE_HEIGHT
        and ledge.height <= MAX_LEDGE_HEIGHT then
        grabLedge(ledge)
    end
end)

