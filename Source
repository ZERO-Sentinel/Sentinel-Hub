buttons.UnlockCursorKeyBind.MouseButton1Click:Connect(function()
    local previousText = buttons.UnlockCursorKeyBind.Text
    buttons.UnlockCursorKeyBind.Text = "Press a key..."
    isBindingUnlockCursorKey = true
    ignoreUnlockCursorToggleAfterBinding = true
    if UnlockCursorConnection then
        UnlockCursorConnection:Disconnect()
    end
    UnlockCursorConnection = UserInputService.InputBegan:Connect(function(input, gameProcessed)
        if input.UserInputType ~= Enum.UserInputType.Keyboard then
            return
        end
        if input.KeyCode == Enum.KeyCode.Space then
            return
        end
        if input.KeyCode == Enum.KeyCode.Escape or input.KeyCode == Enum.KeyCode.Backspace then
            UnlockCursorKeyBind = nil
            buttons.UnlockCursorKeyBind.Text = "Unlock Cursor\nKey: ..."
            isBindingUnlockCursorKey = false
            UnlockCursorConnection:Disconnect()
            UnlockCursorConnection = nil
            task.defer(function()
                ignoreUnlockCursorToggleAfterBinding = false
            end)
            return
        end
        UnlockCursorKeyBind = input.KeyCode
        buttons.UnlockCursorKeyBind.Text =
            "Unlock Cursor\nKey: " .. UnlockCursorKeyBind.Name

        isBindingUnlockCursorKey = false
        lastUnlockCursorBindTime = tick()
        UnlockCursorConnection:Disconnect()
        UnlockCursorConnection = nil
        task.defer(function()
            ignoreUnlockCursorToggleAfterBinding = false
        end)
    end)
end)

