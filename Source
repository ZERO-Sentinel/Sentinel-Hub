local function disableAllFeatures()
    if isAntiFlingEnabled then
        isAntiFlingEnabled = false
        disableAntiFling()
        buttons.AntiFling.Text = "Anti Fling: Off"
    end

    if isNoClipEnabled then
        isNoClipEnabled = false
        disableNoClip()
        buttons.NoClip.Text = "No Clip: Off"
    end

    if isInfJumping then
        isInfJumping = false
        disableInfJump()
        buttons.InfiniteJump.Text = "Infinite Jump: Off"
    end

    if isAirStrafeEnabled then
        isAirStrafeEnabled = false
        buttons.AirStrafe.Text = "Air Strafe: Off"
    end

    if isMomentumEnabled then
        isMomentumEnabled = false
        buttons.Momentum.Text = "Ground Momentum: Off"
    end

    if isNoSlowEnabled then
        isNoSlowEnabled = false
        buttons.NoSlow.Text = "No Slow: Off"
    end

    if isXRAYEnabled then
        isXRAYEnabled = false
        DisableXRAY()
        buttons.XRAY.Text = "XRAY: Off"
    end

    if thirdPersonState ~= 0 then
        thirdPersonState = 0
        DisableThirdPerson()
        buttons.ThirdPerson.Text = "Force Third Person: Off"
    end

    if firstPersonState ~= 0 then
        firstPersonState = 0
        DisableFirstPerson()
        buttons.FirstPerson.Text = "Force First Person: Off"
    end

    if isCursorUnlocked then
        isCursorUnlocked = false
        ToggleCursor()
        buttons.UnlockCursor.Text = "Unlock Cursor: Off\n(PC Only)"
    end

    if isSkeletonESP or isBoxESP or isChamsESP then
        isSkeletonESP = false
        isBoxESP = false
        isChamsESP = false
        buttons.ESPSkeletons.Text = "Skeleton ESP: Off"
        buttons.ESPBoxes.Text = "Box ESP: Off"
        buttons.ESPChams.Text = "Chams ESP: Off"
    end

    if TeamCheckESP then
        TeamCheckESP = false
        buttons.TeamCheck.Text = "Team Check ESP: Off"
    end

    if isLedgeClimbingEnabled then
        isLedgeClimbingEnabled = false
        buttons.LedgeClimbing.Text = "Ledge Climbing: Off\n(Beta)"
    end

    if isLedgeClimberEnabled then
        isLedgeClimberEnabled = false
        buttons.LedgeClimber.Text = "Ledge Climber: Off\n(Beta)"
    end

    if isFullBrightEnabled then
        isFullBrightEnabled = false
        restoreLighting()
        buttons.FullBright.Text = "Full Bright: Off"
    end
end
